# PhantomBuster API key (Settings → API)
PHANTOMBUSTER_API_KEY=

# LinkedIn session cookie (copy from PB phantom config — expires periodically, update when needed)
PB_LI_SESSION_COOKIE=

# LinkedIn user agent (match your browser's User-Agent string)
PB_LI_USER_AGENT=

# PhantomBuster phantom IDs (copy from PB dashboard after creating phantoms)
PB_SEARCH_EXPORT_ID=
PB_NETWORK_BOOSTER_ID=
PB_MESSAGE_SENDER_ID=
# LEGACY — the LinkedIn Profile Scraper agent was DELETED from the PB
# workspace (GET /agents/fetch → 404). Only set this if you deploy a NEW
# Profile Scraper phantom and explicitly select
# PRE_INVITE_DEGREE_CHECK_BACKEND=regular; the launch sites preflight this
# id and fail loud if it doesn't resolve.
PB_PROFILE_SCRAPER_ID=

# --- Sales Navigator phantoms (Sales Nav migration, PR-A/PR-B) ---
# See docs/runbooks/sales-nav-enrichment.md for setup walkthrough.

# Sales Navigator Profile Scraper phantom ID. Used by the new pre-invite
# degree check (PR-B) to scrape connection degree against /sales/lead URLs.
# Required when PRE_INVITE_DEGREE_CHECK_BACKEND=sales_nav.
PB_SALES_NAV_PROFILE_SCRAPER_ID=

# Sales Navigator URL Converter phantom ID. NOT NEEDED.
#
# Resolved 2026-05-25 via wet probe on phantom 602790655114603: the Sales
# Nav Profile Scraper auto-converts linkedin.com/in/<slug> URLs internally.
# Pass /in/ URLs directly via the spreadsheetUrl argument; the phantom logs
# `[load_]🔄 Converting regular URL ...` then scrapes the converted lead.
# No separate URL Converter phantom is installed and the variable below is
# kept as a placeholder for any future workflow that needs explicit URL
# conversion (e.g., enrichment of a column outside the scrape pipeline).
PB_SALES_NAV_URL_CONVERTER_ID=

# Sales Navigator session cookies. Separate from PB_LI_SESSION_COOKIE so
# rotations don't cross-contaminate the other phantoms (Search Export,
# Network Booster, Message Sender, Inbox Scraper, regular Profile Scraper).
# Capture from a logged-in Sales Nav browser tab via DevTools → Application →
# Cookies → linkedin.com. See docs/runbooks/phantombuster-cookie-rotation.md.
# - PB_LI_SALES_NAV_SESSION_COOKIE = li_at value (matches PB_LI_SESSION_COOKIE
#   if both accounts are the same).
# - PB_LI_SALES_NAV_LI_A_COOKIE = li_a value (Sales Nav-specific; regular
#   LinkedIn phantoms do not need this).
PB_LI_SALES_NAV_SESSION_COOKIE=
PB_LI_SALES_NAV_LI_A_COOKIE=

# Pre-invite degree-check backend (Sales Nav migration, PR-B).
# Valid values: regular | sales_nav. Code DEFAULT is sales_nav (flipped
# when the legacy LinkedIn Profile Scraper agent was deleted from the PB
# workspace — `regular` is documented-dead and requires deploying a new
# phantom + setting PB_PROFILE_SCRAPER_ID first).
# Hot-reload semantics: read per-invocation of _pre_invite_degree_check,
# so a fresh `python3 cli.py daily` process picks up the new value.
# When set to sales_nav, STRICT_PRE_INVITE_DEGREE_CHECK enforces presence
# of PB_SALES_NAV_PROFILE_SCRAPER_ID (not PB_PROFILE_SCRAPER_ID).
PRE_INVITE_DEGREE_CHECK_BACKEND=sales_nav

# Google Sheets — spreadsheet ID for AutoConnect phantom input
# Set up OAuth: save google-oauth.json to credentials/, run once to authorize
GSHEET_AUTOCONNECT_ID=

# Resend API key (for weekly report emails)
RESEND_API_KEY=

# Resend from address (must match a verified domain in Resend dashboard)
# Replace with your own verified sender address.
RESEND_FROM_ADDRESS=Outbound Agent <outbound@example.com>

# --- Email drip kill switch ---
# The drip senders (email-daily, email-wave2) are DISARMED unless this is set to
# a truthy value (1/true/yes/on). Leave it unset: contacts can sit at stage
# `queued` for months while RESEND_API_KEY stays configured, so an accidental
# --yes mails live prospects. --dry-run is always allowed.
# Arm one run with:
#   OUTBOUND_EMAIL_ENABLED=1 python3 cli.py email-daily --yes
# email-association, email-unsubscribe and email-import are NOT gated.
OUTBOUND_EMAIL_ENABLED=

# --- Email campaign identity + compliance (CAN-SPAM / GDPR) ---
# From / reply-to for the drip campaign (distinct from RESEND_FROM_ADDRESS, which
# is the weekly-report sender).
EMAIL_FROM=Outbound Agent <outbound@example.com>
EMAIL_REPLY_TO=outbound@example.com
# The live-send gate enforces THREE things (--dry-run is exempt from all of
# them): a physical postal address, a resolvable sender org, and an unsubscribe
# address. It also refuses to send when the local sent-ledger
# (~/.outbound-agent/email_sent.json) is corrupt — repair or delete it first.
#
# REQUIRED for live email sends: a valid physical postal address shown in every
# message footer (CAN-SPAM). Live sends fail loud until this is set.
EMAIL_PHYSICAL_ADDRESS=
# Legal sender/org name for the footer (defaults to the EMAIL_FROM display name).
# Must resolve non-empty for a live send, or the footer would ship the literal
# "[EMAIL_SENDER_ORG not set]" placeholder.
EMAIL_SENDER_ORG=
# Unsubscribe inbox for the List-Unsubscribe mailto header (defaults to
# EMAIL_REPLY_TO). One of the two must be set for a live send. Monitor it and run
# `sales email-unsubscribe <email>` to honor opt-outs — that marks EVERY person
# record sharing the address, not just the first. (A hosted one-click HTTP
# endpoint + Resend webhook are optional operator infra — see GETTING_STARTED.md.)
EMAIL_UNSUBSCRIBE_MAILTO=

# --- Gmail conversation sweep (scripts/gmail_sweep.py) ---
# Your OWN mail domains, comma-separated (subdomains included automatically).
# The sweep uses them to tell a message you sent from one you received; with
# none configured it refuses to run, because every thread would then report as
# "you owe a reply". Falls back to the domain of EMAIL_FROM / EMAIL_REPLY_TO
# when unset, so a configured email lane already covers the common case.
# OUTBOUND_INTERNAL_DOMAINS=acme.com,acme.io
#
# Extra vendor / ESP domains to silence in the sweep, comma-separated, added to
# the built-in allow-list. Suffix match on the registrable domain, so
# `sns.amazonaws.com` matches `amazonaws.com` while a lookalike brand does not.
# Silencing is STRUCTURAL — a matched sender vanishes from the radar entirely,
# with no trace in the output — so only add domains that can never be a
# counterparty.
# OUTBOUND_SWEEP_VENDOR_DOMAINS=

# Attio API key (Settings → Developers → API keys)
# Required scopes: Records, List Entries, List Configuration, Notes (Read-write)
ATTIO_API_KEY=

# Attio list ID for the "LinkedIn Outreach" pipeline
ATTIO_LIST_ID=

# Email recipient for weekly reports. Replace with your own address.
REPORT_EMAIL=ops@example.com

# --- Botdog: OPTIONAL alternative delivery transport (off by default) ---

# PhantomBuster owns sending: no code path routes an invite or a DM to
# Botdog, and no value here can change that. These vars only matter if you
# wire the optional Botdog surface yourself. See GETTING_STARTED.md →
# "(Optional) Botdog delivery transport" and config/botdog.example.yaml.

# Botdog API key (Botdog dashboard → API). Leave blank unless you use it —
# an ordinary run never reads it.
# BOTDOG_API_KEY=

# Turns on Phase 0.7, the READ-ONLY event drain: it polls Botdog lead
# events so rows stamped send_channel=botdog can absorb their confirming
# accept / DM-advance / reply events. It does NOT enable Botdog sending.
# Default off (the phase is a one-line skip). Set it HERE, not as a shell
# export — a shell export does not reach a scheduled run.
# BOTH switches must be on: this variable AND `enabled: true` in
# config/botdog.yaml. `enabled: false` keeps every Botdog surface inert,
# and the drain then says so and skips.
# BOTDOG_SEND_ENABLED=false

# --- Pain-signal discovery lane (OPTIONAL, OFF BY DEFAULT) ---
# A second prospect-supply lane: it searches LinkedIn POSTS for your buyers'
# own pain phrases and treats the people who wrote / commented on / reacted to
# a matching post as candidates, through the normal qualify pipeline. It only
# COMMITS prospects (Prospect stage, standard quarantine) — it never sends.
#
# Two independent switches, BOTH required:
#   1. this flag, set to the literal "1" (nothing else enables it), and
#   2. an operator-APPROVED content/pain_keywords.json. The shipped registry is
#      a placeholder and is refused on its sentinel alone, so flipping the
#      status without replacing the queries still cannot scrape.
# Unset, `cli.py pain-signal` aborts and the daily run's Phase 0.9 is one
# status line. See GETTING_STARTED.md.
# OUTBOUND_PAIN_SIGNAL_ENABLED=1

# Recency window for matched posts, in hours. Overrides
# `config.post_max_age_hours_default` in the keyword registry (default 24).
# Capped at 168: the engagement note places the post inside the past week, so a
# wider window REFUSES to run rather than ship a time overclaim.
# OUTBOUND_PAIN_SIGNAL_POST_MAX_AGE_HOURS=24

# Worker phantom ids for the lane. These are the WORKERS inside a "post
# commenter and liker scraper" workflow — NOT the workflow parent, whose API
# launches are silent no-ops. Also settable in config/phantombuster.yaml under
# `agents.pain_posts_worker` / `pain_commenters_worker` / `pain_likers_worker`.
# The posts worker is required when the lane is enabled; the other two are
# optional (blank = posters-only mode, announced on every run). Enrichment
# reuses PB_SALES_NAV_PROFILE_SCRAPER_ID.
# PB_PAIN_POSTS_WORKER_ID=
# PB_PAIN_COMMENTERS_WORKER_ID=
# PB_PAIN_LIKERS_WORKER_ID=

# Connected LinkedIn account id, used only by the limits sync. Auto-resolves
# when exactly one account is connected. Also settable in config/botdog.yaml.
# BOTDOG_ACCOUNT_ID=

# Emergency override for the never-contact blacklist gate. =1 downgrades
# the gate to a loud warning instead of a hard block. Never set this
# permanently: the gate is what stops a first Botdog send from
# cold-contacting someone you must never contact.
#
# Only matters if you WIRED the gate. It is a helper
# (workflows.daily_check_helpers.assert_botdog_blacklist_seeded), not an
# automatic check — no path in this engine calls it, so this variable is
# inert on a stock install.
# BOTDOG_SKIP_BLACKLIST_CHECK=

# --- Operator-tunable thresholds ---

# Deal-name product suffix used by scripts/attio_dedup.py deal dedup.
# If your CRM deal names carry a "Company — <product>" suffix, set the
# product token here so dedup collapses name variants. Default: unset
# (no suffix stripping).
# OUTBOUND_DEAL_NAME_SUFFIX=YourProduct

# Your own LinkedIn profile URL (https://www.linkedin.com/in/<your-slug>).
# Used by scripts/validate_sales_nav_health.py (the /sales-daily Phase 0
# pre-flight) as the scrape probe for Sales Navigator cookie health.
# Required for the health check; it fails loud if unset.
# OUTBOUND_SELF_LINKEDIN_URL=https://www.linkedin.com/in/your-slug

# Operator timezone for daily-run calendar (quarantine + send-day gating).
# Defaults to America/Lima if unset. UTC cron drift can shift the calendar
# by 5 hours, so set this if running in a different operator timezone.
# OUTBOUND_TZ=America/Lima

# Fresh-prospect quarantine window in business days. A new PROSPECT
# cannot receive its first invite until today + this many business days.
# Default: 2.
# OUTBOUND_PROSPECT_QUARANTINE_BDAYS=2

# Pipeline-starvation alarm floors. Each opens a typed queue row when
# the corresponding floor is crossed. False-alarm guard suppresses
# stale_weekly within MIN_BDAYS_SINCE_COMMIT of the last commit.
# OUTBOUND_STARVATION_LOW_PROSPECTS_FLOOR=10
# OUTBOUND_STARVATION_SHORT_RUNWAY_BDAYS=3
# OUTBOUND_STARVATION_DAILY_INVITE_RATE=15
# OUTBOUND_STARVATION_STALE_WEEKLY_BDAYS=7
# OUTBOUND_STARVATION_MIN_BDAYS_SINCE_COMMIT=5

# LinkedIn inbox scraper used for reply detection; keep unset until configured.
PB_INBOX_SCRAPER_ID=

# Attended dispatch: enable only in the engine child process.
OUTBOUND_USE_LLM_DISPATCH=0
# Private per-run directory returned by workflows.codex_dispatch init.
OUTBOUND_LLM_DISPATCH_SESSION=
# Provider-backed verified inbox identity bridge, when needed.
OUTBOUND_INBOX_IDENTITY_MAP=
